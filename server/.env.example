NODE_ENV=development
PORT=4000

# PostgreSQL connection string (e.g. from a local Postgres instance or a hosted provider like Neon/Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/certifyflow?schema=public"

# Use a long, random string in production
JWT_SECRET="dev-only-change-me-to-a-long-random-secret"
JWT_EXPIRES_IN=7d

COOKIE_NAME=cf_token

# The client app's origin, used for CORS and as the base for QR-code verify links
CLIENT_URL=http://localhost:5173

# Where generated certificate PDFs are written on disk (relative to server/, or an absolute path)
STORAGE_DIR=storage

# Optional: public base URL used to build the verify link embedded in certificate QR codes.
# Defaults to CLIENT_URL if not set.
# PUBLIC_VERIFY_BASE_URL=https://your-app.example.com

# Public base URL of THIS server, used to build absolute URLs for uploaded logos/signatures
# so they load correctly both in the browser and inside Puppeteer-rendered PDFs.
# Defaults to http://localhost:<PORT> if not set.
# PUBLIC_SERVER_URL=https://api.your-app.example.com
