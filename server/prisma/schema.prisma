generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  FEST
  HACKATHON
  WORKSHOP
  INTERNSHIP
  SPORTS
  CONFERENCE
  SEMINAR
  TRAINING
  OTHER

  @@map("event_type")
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("event_status")
}

enum CertificateStatus {
  GENERATED
  REVOKED

  @@map("certificate_status")
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  email               String   @unique
  passwordHash        String   @map("password_hash")
  logoUrl             String?  @map("logo_url")
  website             String?
  brandColor          String?  @map("brand_color")
  address             String?
  phone               String?
  certificateIdPrefix String   @default("CF") @map("certificate_id_prefix")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  events       Event[]
  certificates Certificate[]

  @@map("organizations")
}

model Event {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  type           EventType    @default(OTHER)
  status         EventStatus  @default(DRAFT)
  startDate      DateTime?    @map("start_date")
  endDate        DateTime?    @map("end_date")
  location       String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  participants     Participant[]
  certificateTypes CertificateType[]
  certificates     Certificate[]

  @@index([organizationId])
  @@map("events")
}

model CertificateTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  category     String?
  thumbnailUrl String?  @map("thumbnail_url")
  htmlContent  String   @map("html_content")
  cssContent   String   @map("css_content")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  certificateTypes CertificateType[]

  @@map("certificate_templates")
}

model CertificateType {
  id                    String              @id @default(cuid())
  eventId               String              @map("event_id")
  event                 Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  certificateTemplateId String              @map("certificate_template_id")
  certificateTemplate   CertificateTemplate @relation(fields: [certificateTemplateId], references: [id])
  name                  String
  title                 String
  description           String?
  signatories           Json?
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  participants Participant[]
  certificates Certificate[]

  @@index([eventId])
  @@map("certificate_types")
}

model Participant {
  id                String           @id @default(cuid())
  eventId           String           @map("event_id")
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  certificateTypeId String?          @map("certificate_type_id")
  certificateType   CertificateType? @relation(fields: [certificateTypeId], references: [id])
  fullName          String           @map("full_name")
  email             String?
  metadata          Json?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  certificate Certificate?

  @@unique([eventId, email])
  @@index([eventId])
  @@index([certificateTypeId])
  @@map("participants")
}

model Certificate {
  id                String            @id @default(cuid())
  certificateId     String            @unique @map("certificate_id")
  organizationId    String            @map("organization_id")
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId           String            @map("event_id")
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  certificateTypeId String            @map("certificate_type_id")
  certificateType   CertificateType   @relation(fields: [certificateTypeId], references: [id])
  participantId     String            @unique @map("participant_id")
  participant       Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  pdfPath           String            @map("pdf_path")
  status            CertificateStatus @default(GENERATED)
  issuedAt          DateTime          @default(now()) @map("issued_at")
  revokedAt         DateTime?         @map("revoked_at")
  verificationCount Int               @default(0) @map("verification_count")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([eventId])
  @@map("certificates")
}
